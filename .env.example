# Copy to .env and fill in. Never commit .env.
NODE_ENV=production
PORT=3000

# Your site's name and public address (used in titles, sitemap and share links)
SITE_NAME=EmploymentNewsHub
SITE_TAGLINE=Latest Govt & Private Job Alerts, Results and Admit Cards
SITE_URL=https://www.yourdomain.com
CONTACT_EMAIL=contact@yourdomain.com

# Admin panel login (/admin). Use a long, unique password.
ADMIN_PASSWORD=change-me-to-a-long-password
# Random string for signing admin sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to true when running behind a reverse proxy / load balancer (Render, Railway, Nginx, Cloudflare)
TRUST_PROXY=true

# Add demo [Sample] posts on first start when the database is empty. Set false for a clean start.
SEED_SAMPLE=true

# Where the SQLite database file lives (keep it on a persistent disk/volume)
# DB_PATH=/app/data/site.db

# ---------- Email job alerts ----------
# SMTP server used to send alerts. Leave SMTP_HOST empty to only log emails (for testing).
# Examples: Brevo (smtp-relay.brevo.com, 587), Amazon SES (email-smtp.<region>.amazonaws.com, 587),
# Mailgun (smtp.mailgun.org, 587), Zoho (smtp.zoho.in, 465). Gmail works for small lists with an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown to subscribers. Use an address on your own domain that your SMTP provider has verified.
MAIL_FROM="EmploymentNewsHub Alerts" <alerts@yourdomain.com>
# Email instant subscribers automatically when you publish a post (true/false)
INSTANT_ALERTS=true
# Daily digest time (hour 0-23) and timezone
DIGEST_HOUR=8
TIMEZONE=Asia/Kolkata
